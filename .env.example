# ---------------------------------------------------------------------------
# Every value here is OPTIONAL.
#
# The app resolves each integration independently: where credentials exist it uses
# the real adapter, where they do not it uses an in-memory one and says so in the UI.
# That is what makes the hosted demo runnable by anyone, and the test suite hermetic.
# ---------------------------------------------------------------------------

# --- Brain -----------------------------------------------------------------
# Unset: the deterministic rules brain drives the call (free, offline, reproducible).
# Set:   Claude drives the call with the same tool schema.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Calendar -------------------------------------------------------
# Service account with domain-wide delegation over the dispatch calendar.
# Paste the private key with literal \n escapes; the adapter unescapes them.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATE_SUBJECT=dispatch@your-company.com
DISPATCH_CALENDAR_ID=dispatch@your-company.com

# --- Telegram --------------------------------------------------------------
# Create the bot with @BotFather, then add it to each group and read the chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_DISPATCH_CHAT_ID=
TELEGRAM_ONCALL_CHAT_ID=
TELEGRAM_SALES_CHAT_ID=
TELEGRAM_MANAGEMENT_CHAT_ID=

# --- Slack -----------------------------------------------------------------
# Incoming webhooks, one per routing channel. Unmapped channels fall back to dispatch.
SLACK_DISPATCH_WEBHOOK_URL=
SLACK_ONCALL_WEBHOOK_URL=
SLACK_SALES_WEBHOOK_URL=
SLACK_MANAGEMENT_WEBHOOK_URL=

# --- Telephony (Twilio) ----------------------------------------------------
# Only needed to take real phone calls; the browser demo does not use these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=https://your-deployment.vercel.app
